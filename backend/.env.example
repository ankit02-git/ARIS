SEMANTIC_MODEL=BAAI/bge-small-en-v1.5
SEMANTIC_CACHE_DIR=
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/aris
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
APP_ENV=development
